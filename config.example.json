{
  "default_worker": "echo",
  "claude_bin": null,
  "claude_binary": "claude",
  "claude_model": "claude-sonnet-5-5",
  "claude_extra_args": [],
  "claude_allowed_tools": ["Read", "Write", "Edit", "Bash", "Glob", "Grep"],
  "claude_max_turns": 25,
  "claude_permission_mode": "acceptEdits",
  "claude_env_passthrough": [
    "HOME",
    "PATH",
    "LANG",
    "LC_ALL",
    "TERM",
    "TMPDIR",
    "USER",
    "SHELL",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY",
    "ALL_PROXY",
    "http_proxy",
    "https_proxy",
    "no_proxy",
    "all_proxy",
    "NODE_EXTRA_CA_CERTS",
    "SSL_CERT_FILE",
    "SSL_CERT_DIR"
  ],
  "timeout_seconds": 300,
  "stale_seconds": 300,
  "heartbeat_seconds": 15,
  "max_retries": 1,
  "daemon_concurrency": 2,
  "daemon_poll_seconds": 0.5,
  "daemon_watchdog_seconds": 5,
  "daemon_shutdown_grace_seconds": 30,
  "runtime_dir": "runtime",
  "brain_model": "cn:deepseek-v4.1-flash",
  "brain_advanced_model": null,
  "brain_escalate_on_complex": false,
  "brain_max_tickets": 8,
  "brain_settings_path": "~/.claude/settings.json",
  "brain_max_tokens": 2048,
  "brain_timeout_seconds": 120,
  "brain_worker": "claude",
  "memory_path": "memory.md",
  "brain_memory_max_chars": 2000,
  "chat_timeout_seconds": 120,
  "chat_poll_seconds": 0.25,
  "http_host": "127.0.0.1",
  "http_port": 8765
}
