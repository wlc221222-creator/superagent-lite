{
  "default_worker": "echo",
  "claude_bin": null,
  "claude_binary": "claude",
  "claude_model": "claude-sonnet-5-5",
  "claude_extra_args": [],
  "claude_allowed_tools": ["Read", "Write", "Edit", "Bash", "Glob", "Grep"],
  "claude_max_turns": 25,
  "claude_permission_mode": "acceptEdits",
  "claude_env_passthrough": [
    "HOME",
    "PATH",
    "LANG",
    "LC_ALL",
    "TERM",
    "TMPDIR",
    "USER",
    "SHELL",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY",
    "ALL_PROXY",
    "http_proxy",
    "https_proxy",
    "no_proxy",
    "all_proxy",
    "NODE_EXTRA_CA_CERTS",
    "SSL_CERT_FILE",
    "SSL_CERT_DIR"
  ],
  "timeout_seconds": 300,
  "stale_seconds": 300,
  "heartbeat_seconds": 15,
  "max_attempts": 1,
  "runtime_dir": "runtime"
}
